<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0a0a0a"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="ZENLOCK"
            android:letterSpacing="0.4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#444444"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Total focus. No escape."/>
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/adminStatusText"
            android:background="@drawable/status_background"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Checking..."/>
        <TextView
            android:textSize="11sp"
            android:gravity="center"
            android:id="@+id/notifAccessText"
            android:background="@drawable/status_background"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:text="Enable notification badges (optional)"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#444444"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="DURATION"
            android:letterSpacing="0.2"/>
        <TextView
            android:textSize="32sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/durationValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="30 minutes"
            android:fontFamily="sans-serif-light"/>
        <SeekBar
            android:id="@+id/durationSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:progressTint="#00e5cc"
            android:thumbTint="#00e5cc"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#444444"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="WHITELIST APPS"
                android:layout_weight="1"
                android:letterSpacing="0.2"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages · WhatsApp · Camera always on (add Phone below)"/>
        </LinearLayout>
        <Button
            android:textSize="12sp"
            android:textColor="#888888"
            android:id="@+id/presetButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:text="�� Preset Lists"
            android:backgroundTint="#141414"/>
        <GridLayout
            android:id="@+id/appsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:rowCount="6"
            android:columnCount="5"/>
        <Button
            android:textSize="13sp"
            android:textColor="#00e5cc"
            android:id="@+id/addAppButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="40dp"
            android:text="+ Add App  (0/30)"
            android:backgroundTint="#1a1a1a"/>
        <View
            android:background="#1a1a1a"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="40dp"/>
        <Button
            android:textSize="14sp"
            android:textColor="#000000"
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="START ZEN MODE"
            android:backgroundTint="#00e5cc"
            android:letterSpacing="0.1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:text="No exit until the timer ends."/>
        <View
            android:background="#1a1a1a"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#444444"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="BROWSER LOCKOUT"
            android:letterSpacing="0.2"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/status_background"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Block new browser installs"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#555555"
                    android:id="@+id/browserLockoutStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Off — browsers install normally"/>
            </LinearLayout>
            <Switch
                android:id="@+id/browserLockoutSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Play Store stays normal for everything else. 24h cooldown to disable."/>
    </LinearLayout>
</ScrollView>
