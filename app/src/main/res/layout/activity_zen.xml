<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0a0a0a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13sp"
        android:textColor="#666666"
        android:id="@+id/batteryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="�� --%"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/topSection"
        android:paddingTop="72dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="10sp"
            android:textColor="#333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="ZENLOCK"
            android:letterSpacing="0.4"/>
        <TextView
            android:textSize="19sp"
            android:textColor="#999999"
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Day, Mon DD"/>
        <TextView
            android:textSize="26sp"
            android:textColor="#cccccc"
            android:id="@+id/currentTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="--:-- --"
            android:fontFamily="sans-serif-light"/>
        <TextView
            android:textSize="56sp"
            android:textColor="#ffffff"
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:fontFamily="sans-serif-thin"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="remaining"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomBar"
        android:layout_below="@+id/topSection">
        <GridLayout
            android:gravity="center"
            android:id="@+id/appsGrid"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:rowOrderPreserved="false"
            android:columnCount="5"/>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomBar"
        android:background="#0a0a0a"
        android:paddingTop="16dp"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="24dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/messagesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <View
                    android:background="@drawable/circle_button_dark"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/messagesIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@android:drawable/sym_action_chat"
                    android:tint="#00e5cc"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/messagesBadge"
                    android:background="@drawable/badge_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="18dp"
                    android:minHeight="18dp"/>
            </FrameLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#555555"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Messages"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/whatsappButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <View
                    android:background="@drawable/circle_button_dark"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/whatsappIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@android:drawable/sym_action_chat"
                    android:tint="#ffffff"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/whatsappBadge"
                    android:background="@drawable/badge_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="18dp"
                    android:minHeight="18dp"/>
            </FrameLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#555555"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="WhatsApp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/cameraButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <View
                    android:background="@drawable/circle_button_dark"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/cameraIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="#ffffff"/>
            </FrameLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#555555"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Camera"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
